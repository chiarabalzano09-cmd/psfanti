<!DOCTYPE html>
<html lang="it" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestionale PS — Dott.ssa Sofia Fanti</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: { extend: {} }
        }
    </script>
    <!-- Alpine.js for interactivity -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="h-full bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans antialiased" x-data="hospitalApp()">

    <!-- Top Header -->
    <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-30 px-4 py-3 shadow-sm">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-sky-600 text-white rounded-xl shadow-md">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-base sm:text-lg font-bold tracking-tight">GESTIONALE PS — Dott.ssa Sofia Fanti</h1>
                        <span class="px-2 py-0.5 text-xs font-semibold bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300 rounded-full border border-sky-200 dark:border-sky-800">Locale v1.0</span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Reparto: <strong>Pronto Soccorso</strong> • Area: <strong>Ginecologia e Ostetricia</strong></p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <span class="text-xs font-medium bg-slate-100 dark:bg-slate-800 px-3 py-1.5 rounded-lg" x-text="currentTime"></span>
                <button @click="darkMode = !darkMode; localStorage.setItem('theme', darkMode ? 'dark' : 'light')" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                    <svg x-show="!darkMode" class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    <svg x-show="darkMode" class="w-5 h-5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </button>
            </div>
        </div>
        <div class="mt-2 text-center bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 rounded-lg py-1 px-3 text-[11px] text-amber-800 dark:text-amber-300">
            ⚠️ Software dimostrativo locale per scopi organizzativi. Utilizzare esclusivamente dati fittizi.
        </div>
    </header>

    <main class="max-w-7xl mx-auto p-4 md:p-6 space-y-6">
        
        <!-- Navigation Tabs -->
        <div class="flex gap-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800">
            <template x-for="tab in tabs">
                <button @click="currentTab = tab.id" 
                    :class="currentTab === tab.id ? 'bg-sky-600 text-white shadow-md shadow-sky-500/20' : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800'"
                    class="px-4 py-2 rounded-xl text-sm font-medium whitespace-nowrap transition-all" x-text="tab.label">
                </button>
            </template>
        </div>

        <!-- TAB 1: DASHBOARD -->
        <div x-show="currentTab === 'dashboard'" class="space-y-6">
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <h2 class="text-xl font-bold mb-1">Dashboard Operativa — Pronto Soccorso</h2>
                <p class="text-sm text-slate-500">Panoramica in tempo reale delle attività e flussi per la Dott.ssa Sofia Fanti.</p>
            </div>

            <!-- KPI Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-slate-500">Pazienti Presenti</p>
                        <p class="text-2xl font-bold mt-1" x-text="patients.filter(p => !p.archived).length"></p>
                    </div>
                    <div class="p-3 bg-sky-500 text-white rounded-xl shadow-md">👥</div>
                </div>
                <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-slate-500">In Attesa / Valutazione</p>
                        <p class="text-2xl font-bold mt-1" x-text="patients.filter(p => !p.archived && (p.status === 'In attesa' || p.status === 'In valutazione')).length"></p>
                    </div>
                    <div class="p-3 bg-amber-500 text-white rounded-xl shadow-md">⏳</div>
                </div>
                <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-slate-500">In Osservazione (OBI)</p>
                        <p class="text-2xl font-bold mt-1" x-text="patients.filter(p => !p.archived && p.status === 'In osservazione').length"></p>
                    </div>
                    <div class="p-3 bg-emerald-500 text-white rounded-xl shadow-md">🛏️</div>
                </div>
                <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-slate-500">Attività da Completare</p>
                        <p class="text-2xl font-bold mt-1" x-text="tasks.filter(t => !t.completed).length"></p>
                    </div>
                    <div class="p-3 bg-rose-500 text-white rounded-xl shadow-md">📋</div>
                </div>
            </div>

            <!-- Recent Patients Table -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <h3 class="font-bold text-base mb-4">Pazienti Recenti in Ingresso</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-400 uppercase">
                                <th class="p-3">Codice / Nome</th>
                                <th class="p-3">Motivo Accesso</th>
                                <th class="p-3">Priorità</th>
                                <th class="p-3">Stato</th>
                                <th class="p-3">Stanza</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-sm">
                            <template x-for="p in patients.filter(p => !p.archived)">
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                    <td class="p-3">
                                        <span class="font-bold" x-text="p.name"></span>
                                        <span class="text-xs text-slate-500 block" x-text="p.code"></span>
                                    </td>
                                    <td class="p-3 font-medium" x-text="p.reason"></td>
                                    <td class="p-3">
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-bold"
                                            :class="{
                                                'bg-red-100 text-red-700': p.priority === 'Rosso',
                                                'bg-orange-100 text-orange-700': p.priority === 'Arancione',
                                                'bg-amber-100 text-amber-700': p.priority === 'Giallo',
                                                'bg-emerald-100 text-emerald-700': p.priority === 'Verde',
                                                'bg-slate-100 text-slate-700': p.priority === 'Bianco'
                                            }" x-text="p.priority"></span>
                                    </td>
                                    <td class="p-3"><span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-sky-50 dark:bg-sky-950 text-sky-600" x-text="p.status"></span></td>
                                    <td class="p-3 text-slate-500" x-text="p.room"></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 2: PAZIENTI -->
        <div x-show="currentTab === 'pazienti'" class="space-y-6">
            <div class="flex justify-between items-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <div>
                    <h2 class="text-xl font-bold">Gestione Pazienti Fittizi</h2>
                    <p class="text-sm text-slate-500">Inserimento e monitoraggio schede pazienti in Pronto Soccorso.</p>
                </div>
                <button @click="openNewPatientModal = true" class="px-4 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-xl text-sm font-medium shadow-md shadow-sky-500/20">
                    + Nuovo Paziente
                </button>
            </div>

            <!-- Patient List -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 dark:bg-slate-800/80 border-b border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-400 uppercase">
                                <th class="p-4">Priorità</th>
                                <th class="p-4">Codice / Nome</th>
                                <th class="p-4">Età</th>
                                <th class="p-4">Motivo Accesso</th>
                                <th class="p-4">Stanza / Letto</th>
                                <th class="p-4">Stato</th>
                                <th class="p-4 text-right">Azioni</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-sm">
                            <template x-for="(p, index) in patients">
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30">
                                    <td class="p-4">
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-bold"
                                            :class="{
                                                'bg-red-100 text-red-700': p.priority === 'Rosso',
                                                'bg-orange-100 text-orange-700': p.priority === 'Arancione',
                                                'bg-amber-100 text-amber-700': p.priority === 'Giallo',
                                                'bg-emerald-100 text-emerald-700': p.priority === 'Verde',
                                                'bg-slate-100 text-slate-700': p.priority === 'Bianco'
                                            }" x-text="p.priority"></span>
                                    </td>
                                    <td class="p-4">
                                        <p class="font-bold" x-text="p.name"></p>
                                        <p class="text-xs text-slate-500" x-text="p.code"></p>
                                    </td>
                                    <td class="p-4" x-text="p.age + ' anni'"></td>
                                    <td class="p-4 font-medium" x-text="p.reason"></td>
                                    <td class="p-4">
                                        <p x-text="p.room"></p>
                                        <p class="text-xs text-slate-500" x-text="p.bed"></p>
                                    </td>
                                    <td class="p-4"><span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-sky-50 dark:bg-sky-950 text-sky-600" x-text="p.status"></span></td>
                                    <td class="p-4 text-right space-x-2">
                                        <button @click="deletePatient(index)" class="text-rose-600 hover:underline text-xs font-bold">Elimina</button>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 3: ATTIVITA' -->
        <div x-show="currentTab === 'attivita'" class="space-y-6">
            <div class="flex justify-between items-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <div>
                    <h2 class="text-xl font-bold">Checklist Operativa Reparto</h2>
                    <p class="text-sm text-slate-500">Organizzazione attività e scadenze quotidiane.</p>
                </div>
                <button @click="openNewTaskModal = true" class="px-4 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-xl text-sm font-medium shadow-md">
                    + Nuova Attività
                </button>
            </div>

            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden p-4 space-y-3">
                <template x-for="(t, index) in tasks">
                    <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" x-model="t.completed" @change="saveData()" class="w-4 h-4 text-sky-600 rounded">
                            <div>
                                <p class="font-bold text-sm" :class="{'line-through text-slate-400': t.completed}" x-text="t.title"></p>
                                <p class="text-xs text-slate-500" x-text="t.description"></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-xs font-bold px-2 py-1 rounded bg-amber-100 text-amber-700" x-text="'Scad. ' + t.dueDate"></span>
                            <button @click="deleteTask(index)" class="text-rose-600 text-xs">✕</button>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <!-- TAB 4: TURNI & INFO -->
        <div x-show="currentTab === 'turni'" class="space-y-6">
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <h2 class="text-xl font-bold mb-2">Calendario Turni e Informazioni</h2>
                <p class="text-sm text-slate-500 mb-4">Profilo principale: <strong>Dott.ssa Sofia Fanti</strong> (Medico Responsabile PS).</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
                        <p class="font-bold text-sm">Oggi: Turno Mattina (08:00 - 14:00)</p>
                        <p class="text-xs text-slate-500 mt-1">Reparto Pronto Soccorso - Area Ginecologia e Ostetricia</p>
                    </div>
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
                        <p class="font-bold text-sm">Domani: Turno Pomeriggio (14:00 - 20:00)</p>
                        <p class="text-xs text-slate-500 mt-1">Sala Osservazione Breve (OBI)</p>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- MODAL NUOVO PAZIENTE -->
    <div x-show="openNewPatientModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm" style="display: none;">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-lg shadow-2xl p-6 space-y-4">
            <h3 class="text-lg font-bold">Registra Nuovo Paziente (Fittizio)</h3>
            <form @submit.prevent="addPatient()" class="space-y-3">
                <div>
                    <label class="block text-xs font-bold uppercase mb-1">Codice</label>
                    <input type="text" x-model="newPatient.code" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border rounded-xl text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase mb-1">Nome o Pseudonimo</label>
                    <input type="text" x-model="newPatient.name" required placeholder="Es. Rossi Anna" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border rounded-xl text-sm">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold uppercase mb-1">Età</label>
                        <input type="number" x-model="newPatient.age" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border rounded-xl text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase mb-1">Priorità</label>
                        <select x-model="newPatient.priority" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border rounded-xl text-sm">
                            <option value="Verde">Verde</option>
                            <option value="Giallo">Giallo</option>
                            <option value="Arancione">Arancione</option>
                            <option value="Rosso">Rosso</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase mb-1">Motivo Accesso</label>
                    <input type="text" x-model="newPatient.reason" required placeholder="Es. Dolore pelvico" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border rounded-xl text-sm">
                </div>
                <div class="flex justify-end gap-2 pt-3">
                    <button type="button" @click="openNewPatientModal = false" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 rounded-xl text-sm">Annulla</button>
                    <button type="submit" class="px-4 py-2 bg-sky-600 text-white rounded-xl text-sm font-medium">Salva</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL NUOVA ATTIVITA -->
    <div x-show="openNewTaskModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm" style="display: none;">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-lg shadow-2xl p-6 space-y-4">
            <h3 class="text-lg font-bold">Nuova Attività</h3>
            <form @submit.prevent="addTask()" class="space-y-3">
                <div>
                    <label class="block text-xs font-bold uppercase mb-1">Titolo</label>
                    <input type="text" x-model="newTask.title" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border rounded-xl text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase mb-1">Descrizione</label>
                    <input type="text" x-model="newTask.description" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border rounded-xl text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase mb-1">Scadenza</label>
                    <input type="text" x-model="newTask.dueDate" value="14:00" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border rounded-xl text-sm">
                </div>
                <div class="flex justify-end gap-2 pt-3">
                    <button type="button" @click="openNewTaskModal = false" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 rounded-xl text-sm">Annulla</button>
                    <button type="submit" class="px-4 py-2 bg-sky-600 text-white rounded-xl text-sm font-medium">Salva</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function hospitalApp() {
            return {
                darkMode: localStorage.getItem('theme') === 'dark' || true,
                currentTab: 'dashboard',
                currentTime: '',
                openNewPatientModal: false,
                openNewTaskModal: false,
                tabs: [
                    { id: 'dashboard', label: '📊 Dashboard' },
                    { id: 'pazienti', label: '👥 Pazienti Fittizi' },
                    { id: 'attivita', label: '📋 Checklist' },
                    { id: 'turni', label: '📅 Turni & Info' }
                ],
                patients: JSON.parse(localStorage.getItem('ps_patients')) || [
                    { code: 'PS-2026-001', name: 'Rossi Elena (Pseudonimo)', age: 28, reason: 'Dolore pelvico', priority: 'Giallo', status: 'In osservazione', room: 'Sala OBI', bed: 'Letto 1', archived: false },
                    { code: 'PS-2026-002', name: 'Bianchi Chiara (Pseudonimo)', age: 34, reason: 'Contrazioni', priority: 'Arancione', status: 'In valutazione', room: 'Sala OBI', bed: 'Letto 2', archived: false }
                ],
                tasks: JSON.parse(localStorage.getItem('ps_tasks')) || [
                    { title: 'Verificare referto emocromo', description: 'Controllare valori paziente Rossi Elena', dueDate: '12:00', completed: false },
                    { title: 'Controllo inventario infusionale', description: 'Verificare scorte in sala OBI', dueDate: '15:00', completed: false }
                ],
                newPatient: { code: 'PS-2026-005', name: '', age: 30, reason: 'Dolore pelvico', priority: 'Verde', status: 'In attesa', room: 'Triage', bed: 'Nessuno', archived: false },
                newTask: { title: '', description: '', dueDate: '14:00', completed: false },

                init() {
                    setInterval(() => {
                        this.currentTime = new Date().toLocaleTimeString('it-IT');
                    }, 1000);
                    this.currentTime = new Date().toLocaleTimeString('it-IT');
                    if (this.darkMode) {
                        document.documentElement.classList.add('dark');
                    }
                },

                saveData() {
                    localStorage.setItem('ps_patients', JSON.stringify(this.patients));
                    localStorage.setItem('ps_tasks', JSON.stringify(this.tasks));
                },

                addPatient() {
                    this.patients.unshift({...this.newPatient});
                    this.saveData();
                    this.openNewPatientModal = false;
                    this.newPatient.name = '';
                },

                deletePatient(index) {
                    if(confirm('Confermi l’eliminazione?')) {
                        this.patients.splice(index, 1);
                        this.saveData();
                    }
                },

                addTask() {
                    this.tasks.push({...this.newTask});
                    this.saveData();
                    this.openNewTaskModal = false;
                    this.newTask.title = '';
                    this.newTask.description = '';
                },

                deleteTask(index) {
                    this.tasks.splice(index, 1);
                    this.saveData();
                }
            }
        }
    </script>
</body>
</html>
